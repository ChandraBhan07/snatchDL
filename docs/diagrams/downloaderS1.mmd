flowchart TD
    downloader@{ shape: rounded, label: "Downloader" }
    wait@{ shape: rounded, label: "Wait for Outgoing Queue" }
    pop@{ shape: rounded, label: "Pop from Outgoing Queue" }
    check@{ shape: diamond, label: "Batch full or outgoing queue exhausted?" }
    
    batch@{ shape: cyl, label: "Batch/ Local Priority Queue" }
    next@{ shape: rounded, label: "Continue to Stage 2" }

    downloader --> wait
    wait --> check
    check -- No --> pop
    pop --> batch
    batch -. Next iteration .-> check
    check -- Yes --> next
    
    
    style pop fill:#D6EAF8,stroke:#2471A3,color:#1B2631
    style wait fill:#D7BDE2,stroke:#884EA0,color:#1B2631
    style check fill:#FCF3CF,stroke:#D4AC0D,color:#1B2631
    style batch fill:#D5F5E3,stroke:#239B56,color:#1B2631
