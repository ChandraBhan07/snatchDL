flowchart TD
    Input@{ shape: manual-input, label: "Input File" }
    Logs@{ shape: docs, label: "Logs" }
    JHistory@{ shape: rounded, label: "Job History" }
    JBuilder@{ shape: rounded, label: "Job Builder" }



    Decision@{ shape: diam, label: "Valid Url?" }
    DecisionJob@{ shape: diam, label: "Valid Job?" }
    DBL@{ shape: cyl, label: "Listening Queue" }
